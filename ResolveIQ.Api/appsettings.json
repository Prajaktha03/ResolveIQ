{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=resolveiq_db;Username=postgres;Password=YourPasswordHere"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "SlaMonitoring": {
    "Enabled": true,
    "IntervalSeconds": 60,
    "WarningWindowMinutes": 15,
    "EscalationDelayMinutes": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://localhost:3000",
      "http://localhost:5173",
      "https://localhost:5173"
    ]
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "GeneralPermitLimit": 100,
    "AiPermitLimit": 20
  },
  "Ai": {
    "Enabled": false,
    "Provider": "Gemini",
    "TimeoutSeconds": 15,
    "Gemini": {
      "Model": "gemini-1.5-flash",
      "ApiKey": "",
      "Endpoint": "https://generativelanguage.googleapis.com/v1beta"
    },
    "OpenAI": {
      "Model": "gpt-4o-mini",
      "ApiKey": "",
      "Endpoint": "https://api.openai.com/v1"
    }
  },
  "Swagger": {
    "Enabled": true
  },
  "AllowedHosts": "*"
}