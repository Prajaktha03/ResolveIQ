# ==============================================================================
# ResolveIQ Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env': cp .env.example .env
# 2. Replace all placeholder values below with strong, unique secrets.
# 3. WARNING: Never commit '.env' or any secret files to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database Settings (Used by Docker Compose and the API)
# ------------------------------------------------------------------------------
POSTGRES_DB=resolveiq_db
POSTGRES_USER=resolveiq_user
# Generate a strong password (minimum 16 characters)
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD_MIN_16_CHARS
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# JWT Authentication Settings
# ------------------------------------------------------------------------------
# IMPORTANT: The JWT Key MUST be a cryptographically random, base64-encoded
# symmetric key of at least 256 bits (32 bytes).
# Generate using PowerShell:
#   $bytes = New-Object byte[] 32; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes); [Convert]::ToBase64String($bytes)
# Or using OpenSSL:
#   openssl rand -base64 32
JWT_KEY=REPLACE_WITH_BASE64_ENCODED_256_BIT_SECRET_KEY_MIN_32_BYTES
JWT_ISSUER=ResolveIQ.Api
JWT_AUDIENCE=ResolveIQ.Clients

# ------------------------------------------------------------------------------
# API Hosting & Network Settings
# ------------------------------------------------------------------------------
API_PORT=5022
ASPNETCORE_ENVIRONMENT=Development
SWAGGER_ENABLED=true
FORWARDED_HEADERS_ALL_PROXIES=false

# ------------------------------------------------------------------------------
# CORS Allowed Origins (Comma-separated for local client frontends)
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
